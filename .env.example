# Cloud providers are OPTIONAL. Any model whose provider has no key is
# automatically marked unavailable at load time -- the router simply skips it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama (no key required)
OLLAMA_BASE_URL=http://localhost:11434

# Enable the deterministic offline mock provider (no network, no cost).
# Useful for running the whole pipeline end-to-end without any API keys.
AUTOPILOT_ENABLE_MOCK=true

AUTOPILOT_DB_PATH=data/autopilot.db
